{
  "manifest_version": 3,
  "name": "aitrack brauseriaeg",
  "version": "1.0.0",
  "description": "Saadab aktiivse vahelehe minutid lokaalsele aitrackile. Andmed jäävad sinu arvutisse; aitrack arvestab ainult projektiga seotud aadresse.",
  "key": "",
  "permissions": ["alarms", "idle", "tabs", "storage", "nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
